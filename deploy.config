# Deployment Configuration
# Single source of truth for all deployment parameters
# Used by both deploy-all.sh and cloudbuild.yaml

# Google Cloud Project Configuration
PROJECT_ID=leyin-sandpit
REGION=australia-southeast1

# Service Names
FRONTEND_SERVICE=data-qa-agent-frontend
BACKEND_SERVICE=data-qa-agent-backend

# Artifact Registry
REGISTRY="${REGION}-docker.pkg.dev"
REPO_NAME="agent-repo"

# Optional: Cloud Build Configuration
# TRIGGER_BRANCH=feature_branch_name
# BUILD_TIMEOUT=1200s
